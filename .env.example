# Your ElevenLabs Conversational Agent ID
# Get it from: https://elevenlabs.io/app/agents (select your agent → copy Agent ID)
# For deployment: set this in your hosting platform's environment variables

VITE_ELEVENLABS_AGENT_ID=your_agent_id_here

# Backend API URL (optional). When set, the app notifies the backend when a user starts or ends a call,
# so the dashboard can refresh call history only when there is new activity (no time-based polling).
# Dev: http://localhost:3001
VITE_API_URL=http://localhost:3001
