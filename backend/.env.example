# Server
PORT=3001

# JWT secret for dashboard auth (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# Dashboard login (Devanshi only - change in production)
DASHBOARD_USER=devanshi
DASHBOARD_PASSWORD=your_secure_password

# ElevenLabs API - from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_xi_api_key
# Agent ID - from https://elevenlabs.io/app/agents
AGENT_ID=your_agent_id

# Google Calendar API – for creating events when user shows intent to schedule a call with Devanshi
# Create OAuth 2.0 credentials (Web application) at https://console.cloud.google.com/apis/credentials
# Enable Calendar API: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
# Use a one-time OAuth flow to get GOOGLE_REFRESH_TOKEN (scope: https://www.googleapis.com/auth/calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: calendar to use (default: primary)
# GOOGLE_CALENDAR_ID=primary
# Optional: IANA timezone for parsed dates (default: UTC)
# GOOGLE_CALENDAR_TIMEZONE=America/Los_Angeles
# Optional: event title (default: Call with Devanshi)
# GOOGLE_CALENDAR_EVENT_TITLE=Call with Devanshi
