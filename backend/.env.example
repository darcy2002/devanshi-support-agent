# Server
PORT=3001

# JWT secret for dashboard auth (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# Dashboard login (Devanshi only - change in production)
DASHBOARD_USER=devanshi
DASHBOARD_PASSWORD=your_secure_password

# ElevenLabs API - from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_xi_api_key
# Agent ID - from https://elevenlabs.io/app/agents
AGENT_ID=your_agent_id
